{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://gpt-templates/representation-profile",
  "title": "Representation Profile",
  "allOf": [
    {
      "$ref": "artifact-manifest.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "id",
    "kind",
    "version",
    "status",
    "title",
    "target_format"
  ],
  "properties": {
    "kind": {
      "const": "representation-profile"
    },
    "target_format": {
      "type": "string"
    },
    "requires": {
      "type": "object"
    },
    "concept_mapping": {
      "type": "object"
    },
    "relationship_mapping": {
      "type": "object"
    },
    "visual_encoding": {
      "type": "object"
    },
    "fidelity": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "context-dependent"
      ]
    },
    "best_for": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "poor_for": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallbacks": {
      "type": "object"
    }
  }
}