{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://gpt-templates/artifact-manifest",
  "title": "Artifact Manifest",
  "type": "object",
  "required": [
    "id",
    "kind",
    "version",
    "status",
    "title"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "blueprint",
        "template",
        "canonical-model",
        "format",
        "representation-profile",
        "overlay",
        "transform",
        "validator",
        "schema",
        "fixture",
        "registry",
        "documentation"
      ]
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "experimental",
        "stable",
        "deprecated",
        "superseded",
        "retired"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "extends": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "compatibility": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}