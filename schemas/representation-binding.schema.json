{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Representation Binding",
  "type": "object",
  "required": ["id", "kind", "version", "status", "model", "format", "fidelity", "compatibility", "mappings"],
  "properties": {
    "id": {"type": "string", "pattern": "^binding\\."},
    "kind": {"const": "representation-binding"},
    "version": {"type": "string"},
    "status": {"type": "string"},
    "title": {"type": "string"},
    "model": {"type": "string", "pattern": "^model\\."},
    "format": {"type": "string", "pattern": "^format\\."},
    "language_definition": {"type": "string"},
    "fidelity": {"enum": ["exact", "high", "binding-dependent", "projection", "approximate", "lossy"]},
    "compatibility": {
      "type": "object",
      "required": ["status", "format_versions", "required_capabilities"],
      "properties": {
        "status": {"enum": ["source-pinned", "verified", "unverified", "unpinned"]},
        "format_versions": {"type": ["string", "null"]},
        "required_capabilities": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "mappings": {"type": "array", "items": {"type": "object", "required": ["abstract", "target"], "properties": {"abstract": {"type": "string"}, "target": {"type": "string"}}, "additionalProperties": true}},
    "feature_bindings": {"type": "object"},
    "losses": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
