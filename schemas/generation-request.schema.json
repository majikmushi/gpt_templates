{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Representation Generation Request",
  "type": "object",
  "required": ["abstract_model", "representation"],
  "properties": {
    "source": {"type": ["string", "object"]},
    "abstract_model": {"type": "string", "pattern": "^model\\."},
    "representation": {
      "type": "object",
      "required": ["format"],
      "properties": {
        "format": {"type": "string", "pattern": "^format\\."},
        "binding": {"type": "string", "default": "auto"},
        "version": {"type": "string"},
        "version_constraint": {"type": "string"},
        "renderer": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {"type": "string", "pattern": "^renderer\\."},
            "version": {"type": "string"}
          },
          "additionalProperties": false
        },
        "compatibility_mode": {"enum": ["strict", "warn"], "default": "strict"}
      },
      "allOf": [{"not": {"required": ["version", "version_constraint"]}}],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "profile": {"type": "string", "pattern": "^style\\."},
        "binding": {"type": "string", "default": "auto"}
      },
      "additionalProperties": false
    },
    "overlays": {"type": "array", "items": {"type": "string", "pattern": "^overlay\\."}},
    "options": {"type": "object"}
  },
  "additionalProperties": false
}
